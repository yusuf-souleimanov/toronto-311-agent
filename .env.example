ANTHROPIC_API_KEY=
# Second LLM platform for the comparison (e.g. a Granite or Llama endpoint)
SECOND_LLM_BASE_URL=
SECOND_LLM_API_KEY=
SECOND_LLM_MODEL=

# Documents older than this many years (from issue date) are flagged non-compliant
MAX_DOC_AGE_YEARS=3
# Fixed "today" for reproducible eval runs (ISO date)
EVAL_AS_OF_DATE=2026-10-01
# Agent flags below this confidence go to human review instead of auto-decision
REVIEW_CONFIDENCE_THRESHOLD=0.8
